---
// src/pages/respons.astro
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="id" translate="no" class="notranslate">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoring Hasil Tes</title>
  <!-- Load Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Load Supabase JS Client CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- Meta Tag Open Graph untuk WA / Medsos -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Rekap Data Kenaikan Jilid - Tahsin" />
  <meta property="og:description" content="Ringkasan kenaikan jilid Harian - SMART AULADI." />
  
  <!-- Memanggil gambar thumb.png dari folder public -->
  <meta property="og:image" content="https://tahsin-smala.vercel.app/respons-thumb.png" />
  <meta property="og:image:width" content="630" />
  <meta property="og:image:height" content="630" />

  <!-- Ikon khusus saat dijadikan shortcut di Home Screen HP -->
  <link rel="manifest" href="/manifest-respons.json" />
  <link rel="apple-touch-icon" href="/respon-icon-.svg" />

  <!-- Mengatur warna status bar -->
  <meta name="theme-color" content="#ffffff" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen pb-10">

  <!-- Sticky Header -->
  <header class="sticky top-0 z-20 bg-white/90 backdrop-blur-md border-b border-slate-200 px-4 py-3 shadow-sm mb-4">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <!-- Tombol Pemicu Sidebar -->
        <button 
          onclick="toggleSidebar(true)" 
          class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors flex items-center justify-center"
          title="Buka Menu Aksi"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <span class="text-xl">📋</span>
        <h1 class="text-base font-bold text-slate-800 tracking-tight">Hasil Tes</h1>
      </div>
      
      <!-- Counter Data Masuk -->
      <div 
        id="data-counter" 
        class="inline-flex items-center gap-1.5 bg-emerald-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-sm"
      >
        <span id="count-text">0 Data Masuk</span>
      </div>
    </div>
  </header>

  <!-- SIDEBAR / DRAWER KIRI (Smooth Slide-over) -->
  <div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 opacity-0 pointer-events-none transition-opacity duration-300" onclick="toggleSidebar(false)"></div>
  
  <aside id="left-sidebar" class="fixed top-0 left-0 bottom-0 w-72 bg-white z-40 shadow-2xl p-5 flex flex-col justify-between -translate-x-full transition-transform duration-300 ease-in-out">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-slate-100 mb-4">
        <div class="flex items-center gap-2">
          <span class="text-lg">⚙️</span>
          <h2 class="font-bold text-slate-800 text-sm">Panel Aksi Guru</h2>
        </div>
        <button onclick="toggleSidebar(false)" class="p-1 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600">
          ✕
        </button>
      </div>
      <p class="text-xs text-slate-500 leading-relaxed mb-6">
        Isi seluruh kolom <b>Naik ke</b> dan <b>Guru Berikutnya</b> pada daftar kartu, lalu tekan tombol di bawah ini untuk menyimpan semuanya sekaligus ke database.
      </p>
    </div>

    <!-- Tombol Simpan Utama di Sidebar -->
    <div class="space-y-3 pb-4">
      <button 
        onclick="saveAllData()"
        id="btn-save-all"
        class="w-full bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-xs font-bold py-3 px-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-2"
      >
        <span>💾 Simpan Semua Perubahan</span>
      </button>
      <p id="save-status" class="text-[11px] text-center text-slate-400 min-h-[16px]"></p>
    </div>
  </aside>

  <!-- Container Konten -->
  <main class="max-w-md mx-auto px-4">
    <div id="content" class="flex flex-col gap-3">
      <!-- Loading State Initial -->
      <div class="flex flex-col items-center justify-center py-12 text-slate-400 gap-2">
        <div class="w-6 h-6 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin"></div>
        <p class="text-xs font-medium">Memuat data...</p>
      </div>
    </div>
  </main>

  <script is:inline>
    const SUPABASE_URL = "https://vxwokdpgkarhiighnybq.supabase.co";
    const SUPABASE_KEY = "sb_publishable_e99BJ-n7_TyiPQB88uDcwA_N0xjtygX"; 

    let supabaseClient;

    // --- DAFTAR PILIHAN NAIK KE (KAPITAL) ---
    const OPSI_NAIK_KE = [
      "1A", "1B", "2A", "2B", "3A", "3B", "4A", "4B",
      "JUZ 27", "AL-QUR'AN", "GHARIB", "TAJWID", "FINISHING", "TAHFIZ"
    ];

    // --- DAFTAR PILIHAN GURU BERIKUTNYA ---
    const OPSI_GURU = [
      "Vera", "Nining", "Dian", "Nurlaela", "Yani", 
      "Retno", "Tris", "Fahmi", "Yoga", "Syukron"
    ];

    function initSupabase() {
      if (window.supabase) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
        loadData();
        setupRealtime();
      } else {
        setTimeout(initSupabase, 100);
      }
    }

    // Fungsi Mengontrol Sidebar
    function toggleSidebar(open) {
      const sidebar = document.getElementById('left-sidebar');
      const backdrop = document.getElementById('sidebar-backdrop');
      if (open) {
        sidebar.classList.remove('-translate-x-full');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
      } else {
        sidebar.classList.add('-translate-x-full');
        backdrop.classList.add('opacity-0', 'pointer-events-none');
      }
    }

    async function loadData() {
      const container = document.getElementById("content");
      const counterText = document.getElementById("count-text");
      if (!container) return;

      const emptyUI = `
        <div class="bg-white border border-dashed border-slate-300 rounded-2xl p-8 text-center my-4">
          <div class="text-3xl mb-2">📥</div>
          <p class="text-sm font-semibold text-slate-600">Belum Ada Data</p>
          <p class="text-xs text-slate-400 mt-1">Hasil tes peserta akan muncul secara otomatis di sini.</p>
        </div>
      `;

      try {
        const { data, error } = await supabaseClient
          .from('hasil_tes')
          .select('*')
          .order('id', { ascending: true });

        if (error || !data || data.length === 0) {
          container.innerHTML = emptyUI;
          if (counterText) counterText.innerText = "0 Data Masuk";
          return;
        }

        const totalItems = data.length;
        if (counterText) counterText.innerText = `${totalItems} Data Masuk`;

        let html = '';
        data.forEach((item, index) => {
          const nomorUrut = index + 1;
          const itemId = item.id;

          const detailTes = item['Detail Tes'] || '-';
          const isLulus = String(detailTes).toUpperCase() === 'LULUS';
          
          const nama = item['Nama Proper'] || item['Nama Siswa'] || '-';
          const kelas = item['Kelas'] || '-';
          const jilid = item['Saat Ini'] || '-';

          const naikKe = item['naik_ke'] || item['Naik ke'] || '';
          const guruBerikutnya = item['guru_berikutnya'] || item['Guru Berikutnya'] || '';

          const catatan = item['Catatan'] || null;
          const date = item['Submission Date'] || '-';

          const cardBorder = isLulus ? 'border-emerald-500' : 'border-rose-500';
          const badgeBg = isLulus ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-rose-50 text-rose-700 border-rose-200';

          html += `
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 ${cardBorder} border-y border-r border-slate-100 transition-all card-item" data-id="${itemId}">
              <!-- Top Row: Nama & Badge -->
              <div class="flex items-start justify-between gap-2 mb-2">
                <h2 class="font-bold text-slate-800 text-sm leading-snug">${nama}</h2>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${badgeBg} shrink-0">
                  ${detailTes}
                </span>
              </div>

              <!-- Metadata Row: Kelas & Jilid -->
              <div class="flex items-center gap-4 text-xs text-slate-500 mb-3">
                <div class="flex items-center gap-1">
                  <span class="text-slate-400 font-medium">Kelas:</span>
                  <span class="font-semibold text-slate-700">${kelas}</span>
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-slate-400 font-medium">Jilid:</span>
                  <span class="font-semibold text-slate-700">${jilid}</span>
                </div>
              </div>

              <!-- Input Fields: Naik ke & Guru Berikutnya -->
              <div class="bg-slate-50 border border-slate-100 rounded-lg p-2.5 mb-2">
                <div class="grid grid-cols-2 gap-2">
                  
                  <!-- Kolom Naik Ke dengan Auto-Suggest -->
                  <div class="flex flex-col gap-1 relative">
                    <label for="naik-ke-${itemId}" class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Naik ke</label>
                    <input 
                      type="text" 
                      id="naik-ke-${itemId}" 
                      value="${naikKe}" 
                      placeholder="Contoh: 1B"
                      autocomplete="off"
                      oninput="handleAutoSuggest(${itemId}, this.value)"
                      onfocus="handleAutoSuggest(${itemId}, this.value)"
                      class="w-full bg-white border border-slate-200 text-xs text-slate-700 rounded px-2 py-1.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 uppercase"
                    />
                    <div id="suggest-box-${itemId}" class="absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-30 hidden max-h-40 overflow-y-auto"></div>
                  </div>

                  <!-- Kolom Guru Berikutnya dengan Auto-Suggest -->
                  <div class="flex flex-col gap-1 relative">
                    <label for="guru-next-${itemId}" class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Guru Berikutnya</label>
                    <input 
                      type="text" 
                      id="guru-next-${itemId}" 
                      value="${guruBerikutnya}" 
                      placeholder="Nama Guru"
                      autocomplete="off"
                      oninput="handleAutoSuggestGuru(${itemId}, this.value)"
                      onfocus="handleAutoSuggestGuru(${itemId}, this.value)"
                      class="w-full bg-white border border-slate-200 text-xs text-slate-700 rounded px-2 py-1.5 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                    />
                    <div id="suggest-box-guru-${itemId}" class="absolute top-full left-0 right-0 mt-1 bg-white border border-slate-200 rounded-lg shadow-lg z-30 hidden max-h-40 overflow-y-auto"></div>
                  </div>

                </div>
              </div>

              <!-- Catatan Opsional -->
              ${catatan ? `
                <div class="mt-2 text-xs bg-slate-50 border border-slate-100 rounded-lg p-2 text-slate-600">
                  📝 ${catatan}
                </div>
              ` : ''}

              <!-- Bottom Row -->
              <div class="mt-3 pt-2 border-t border-slate-50 flex items-center justify-between text-[10px] text-slate-400">
                <span class="w-5 h-5 flex items-center justify-center rounded-full bg-slate-100 text-slate-500 font-bold text-[10px]">
                  ${nomorUrut}
                </span>
                <span class="font-medium">${date}</span>
              </div>
            </div>
          `;
        });

        container.innerHTML = html;

        // Listener global untuk menutup semua suggestion box jika diklik di luar input
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.relative')) {
            document.querySelectorAll("[id^='suggest-box-']").forEach(box => box.classList.add('hidden'));
          }
        });

      } catch (err) {
        container.innerHTML = emptyUI;
        if (counterText) counterText.innerText = "0 Data Masuk";
      }
    }

    // --- FITUR AUTO SUGGEST NAIK KE ---
    function handleAutoSuggest(id, keyword) {
      const suggestBox = document.getElementById(`suggest-box-${id}`);
      if (!suggestBox) return;

      const cleanKeyword = keyword.trim().toUpperCase();
      const filtered = OPSI_NAIK_KE.filter(item => item.includes(cleanKeyword));

      if (filtered.length === 0 || cleanKeyword === "") {
        suggestBox.classList.add('hidden');
        suggestBox.innerHTML = '';
        return;
      }

      let listHtml = '';
      filtered.forEach(option => {
        let highlightedText = option;
        if (cleanKeyword.length > 0) {
          const regex = new RegExp(`(${cleanKeyword})`, 'gi');
          highlightedText = option.replace(regex, `<span class="bg-emerald-100 text-emerald-800 font-bold px-0.5 rounded">$1</span>`);
        }

        listHtml += `
          <div 
            onclick="selectSuggestion(${id}, '${option}')"
            class="px-3 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 cursor-pointer border-b border-slate-50 last:border-none transition-colors font-medium"
          >
            ${highlightedText}
          </div>
        `;
      });

      suggestBox.innerHTML = listHtml;
      suggestBox.classList.remove('hidden');
    }

    function selectSuggestion(id, value) {
      const inputEl = document.getElementById(`naik-ke-${id}`);
      const suggestBox = document.getElementById(`suggest-box-${id}`);
      if (inputEl) inputEl.value = value;
      if (suggestBox) suggestBox.classList.add('hidden');
    }

    // --- FITUR AUTO SUGGEST GURU ---
    function handleAutoSuggestGuru(id, keyword) {
      const suggestBox = document.getElementById(`suggest-box-guru-${id}`);
      if (!suggestBox) return;

      const cleanKeyword = keyword.trim().toLowerCase();
      const filtered = OPSI_GURU.filter(item => item.toLowerCase().includes(cleanKeyword));

      if (filtered.length === 0 || cleanKeyword === "") {
        suggestBox.classList.add('hidden');
        suggestBox.innerHTML = '';
        return;
      }

      let listHtml = '';
      filtered.forEach(option => {
        let highlightedText = option;
        if (cleanKeyword.length > 0) {
          const regex = new RegExp(`(${cleanKeyword})`, 'gi');
          highlightedText = option.replace(regex, `<span class="bg-emerald-100 text-emerald-800 font-bold px-0.5 rounded">$1</span>`);
        }

        listHtml += `
          <div 
            onclick="selectSuggestionGuru(${id}, '${option}')"
            class="px-3 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 cursor-pointer border-b border-slate-50 last:border-none transition-colors font-medium"
          >
            ${highlightedText}
          </div>
        `;
      });

      suggestBox.innerHTML = listHtml;
      suggestBox.classList.remove('hidden');
    }

    function selectSuggestionGuru(id, value) {
      const inputEl = document.getElementById(`guru-next-${id}`);
      const suggestBox = document.getElementById(`suggest-box-guru-${id}`);
      if (inputEl) inputEl.value = value;
      if (suggestBox) suggestBox.classList.add('hidden');
    }

    // --- FUNGSI SIMPAN SEMUA PERUBAHAN KE DATABASE ---
    async function saveAllData() {
      const btn = document.getElementById('btn-save-all');
      const statusText = document.getElementById('save-status');
      if (!btn) return;

      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = `<span>⏳ Menyimpan Semua...</span>`;
      statusText.innerText = "Mengirim data ke database...";

      try {
        const cardElements = document.querySelectorAll('.card-item');
        let updates = [];
        
        cardElements.forEach(card => {
          const id = card.getAttribute('data-id');
          const naikKeInput = document.getElementById(`naik-ke-${id}`);
          const guruNextInput = document.getElementById(`guru-next-${id}`);

          if (id && naikKeInput && guruNextInput) {
            updates.push({
              id: Number(id),
              naik_ke: naikKeInput.value.toUpperCase(),
              guru_berikutnya: guruNextInput.value
            });
          }
        });

        for (let item of updates) {
          const { error } = await supabaseClient
            .from('hasil_tes')
            .update({
              'naik_ke': item.naik_ke,
              'guru_berikutnya': item.guru_berikutnya
            })
            .eq('id', item.id);

          if (error) throw error;
        }

        btn.className = "w-full bg-slate-800 text-white text-xs font-bold py-3 px-4 rounded-xl shadow-md transition-all";
        btn.innerHTML = `✅ Berhasil Disimpan!`;
        statusText.innerText = "Semua perubahan tersimpan permanen.";

        setTimeout(() => {
          btn.disabled = false;
          btn.className = "w-full bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-xs font-bold py-3 px-4 rounded-xl shadow-md transition-all flex items-center justify-center gap-2";
          btn.innerHTML = originalText;
          statusText.innerText = "";
          toggleSidebar(false); 
        }, 1500);

      } catch (err) {
        alert("Gagal menyimpan data: " + err.message);
        btn.disabled = false;
        btn.innerHTML = originalText;
        statusText.innerText = "Terjadi kesalahan.";
      }
    }

    function setupRealtime() {
      supabaseClient
        .channel('realtime-hasil-tes')
        .on(
          'postgres_changes',
          { event: '*', schema: 'public', table: 'hasil_tes' },
          () => {
            const activeElement = document.activeElement;
            const isTyping = activeElement && activeElement.tagName === 'INPUT';
            if (!isTyping) {
              loadData();
            }
          }
        )
        .subscribe();
    }

    window.addEventListener('DOMContentLoaded', initSupabase);
  </script>
</body>
</html>